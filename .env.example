# ==== Supabase ====
# Dashboard → Settings → API keys
NEXT_PUBLIC_SUPABASE_URL=****
# Publishable key (segura para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=****
# Secret key (sb_secret_...): SOLO servidor. Salta la RLS — nunca en el cliente.
# Preferir sb_secret_ sobre la legacy service_role (rotación/revocación individual).
SUPABASE_SECRET_KEY=****

# HMAC de identidad invitada (SOLO servidor, 32+ caracteres aleatorios).
# No se guarda IP ni user-agent en claro. Rotarlo reinicia esos identificadores.
GUEST_LIMIT_SECRET=****
# Origen público usado en enlaces de verificación (SOLO servidor).
SITE_URL=https://zulu.ejemplo.org

# ==== Gemini (Developer API, NO Vertex) ====
# https://aistudio.google.com/apikey
GEMINI_API_KEY=****
GEMINI_MODEL=gemini-3.5-flash
# Solo servidor. gemini-3.5-flash admite: minimal, low, medium, high.
# Si falta o es inválido, el servidor usa medium para preservar calidad.
GEMINI_THINKING_LEVEL=low

# ==== Piloto ====
# El límite diario de chat turns vive en la tabla app_settings
# (clave max_chat_turns_per_user_per_day), no en variables de entorno.
# Gate de consentimiento: fijar cuando exista la política publicada.
# Versión canónica por defecto: acuerdo-csn-369-2020-03-09.
# Solo definirla al publicar una revisión posterior de la política.
# PRIVACY_POLICY_VERSION=acuerdo-csn-369-2020-03-09
